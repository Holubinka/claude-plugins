#!/bin/sh
# Runs the checks CI runs, before anything leaves the machine.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip deliberately:       git push --no-verify
#
# Kept to the fast checks — about five seconds in total — so there is never a reason to
# reach for --no-verify out of impatience. The full site build stays in CI, and so do
# the behaviour evals, which call a model and cost money.
#
# `astro check` is here because it earned it: the site jobs were skipped on every pull
# request for weeks, so a type error in an island reached CI unchallenged and nothing
# local would have caught it either. It is the slowest check here by an order of
# magnitude and still worth its three seconds.

set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

fail=0
run() {
  printf '  %-34s' "$1"
  shift
  if out=$("$@" 2>&1); then
    printf 'ok\n'
  else
    printf 'FAILED\n\n'
    printf '%s\n\n' "$out"
    fail=1
  fi
}

echo "pre-push checks"
run "lint-structure.py"        python3 scripts/lint-structure.py
run "build-index.py --check"   python3 scripts/build-index.py --check
run "plugin-set audit"         python3 plugins/agent-authoring/scripts/audit-harness.py plugins/
run "hook self-tests"          sh -c 'for s in plugins/*/scripts/selftest.sh; do [ -x "$s" ] || continue; bash "$s" || exit 1; done'


# Both site checks need the dependencies installed, and the type check also needs the
# generated catalogue: catalog.ts imports it, so TypeScript infers the data's types from
# the file itself and its absence reads as a type error rather than a missing input.
# `build-index.py --check` above validates the catalogue without writing it.
if [ ! -d site/node_modules ]; then
  printf '  %-34sskipped (run npm install in site/)\n' "astro check"
  printf '  %-34sskipped (run npm install in site/)\n' "search probes"
elif [ ! -f site/src/data/catalog.json ]; then
  printf '  %-34sskipped (run scripts/build-index.py)\n' "astro check"
  printf '  %-34sskipped (run scripts/build-index.py)\n' "search probes"
else
  run "astro check"            sh -c 'cd site && npx astro check'
  run "search probes"          sh -c 'cd site && node tests/search.test.mjs'
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "push aborted. Fix the above, or use --no-verify if you know better."
  exit 1
fi
echo "all good"
