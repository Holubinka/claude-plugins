---
import '../styles/tokens.css';
import { marketplace, stats } from '../lib/catalog';
import { href } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Page-level <h1>; omit when the page renders its own header. */
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const name = marketplace.name ?? 'catalogue';
const full = title === name ? name : `${title} · ${name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.invalid');

const nav = [
  { label: 'Catalogue', path: '/' },
  { label: 'Bundle', path: '/bundle/' },
  { label: 'Triggers', path: '/triggers/' },
  { label: 'Graph', path: '/graph/' },
  { label: 'Releases', path: '/releases/' },
];
const here = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" type="application/atom+xml" title={`${name} releases`} href={href('/feed.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@600&display=swap"
    />
    <script is:inline>
      // Applied before paint so an explicit choice does not flash the system theme.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="brand" href={href('/')}>
          <span class="brand__name">{name}</span>
          <span class="brand__meta">{stats.plugins} plugins · {stats.artifacts} artifacts</span>
        </a>
        <nav class="nav" aria-label="Sections">
          {nav.map((item) => (
            <a
              href={href(item.path)}
              aria-current={here === href(item.path) ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>
        <button class="button button--ghost theme" type="button" data-theme-toggle aria-label="Switch theme">
          <span data-theme-label>Theme</span>
        </button>
      </div>
    </header>

    <main id="main" class={wide ? 'shell main main--wide' : 'shell main'}>
      <slot />
    </main>

    <footer class="footer">
      <div class="shell footer__inner">
        <span>Built from the repository — every page here is generated, none is written by hand.</span>
        {marketplace.repo && (
          <a href={`https://github.com/${marketplace.repo}`}>{marketplace.repo}</a>
        )}
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const label = document.querySelector('[data-theme-label]');
      const paint = () => {
        if (label) label.textContent = root.dataset.theme === 'dark' ? 'Dark' : root.dataset.theme === 'light' ? 'Light' : 'System';
      };
      paint();
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const order = ['system', 'light', 'dark'];
        const current = root.dataset.theme ?? 'system';
        const next = order[(order.indexOf(current) + 1) % order.length];
        if (next === 'system') {
          delete root.dataset.theme;
          try { localStorage.removeItem('theme'); } catch {}
        } else {
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
        }
        paint();
      });

      // One handler for every copy button on the page.
      document.addEventListener('click', async (event) => {
        const button = (event.target as HTMLElement)?.closest<HTMLElement>('[data-copy]');
        if (!button) return;
        const text = button.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
          const previous = button.textContent;
          button.textContent = 'Copied';
          setTimeout(() => { button.textContent = previous; }, 1400);
        } catch {
          button.textContent = 'Press ⌘C';
        }
      });
    </script>

    <style>
      .skip {
        position: absolute; left: -9999px; top: 0; z-index: 10;
        background: var(--surface); color: var(--ink);
        padding: .6rem 1rem; border: 1px solid var(--accent);
      }
      .skip:focus { left: .5rem; top: .5rem; }

      .masthead { border-bottom: 1px solid var(--rule); background: var(--surface); }
      .masthead__inner {
        display: flex; align-items: center; gap: 1.5rem;
        padding-block: .85rem; flex-wrap: wrap;
      }
      .brand { display: flex; flex-direction: column; gap: .1rem; color: var(--ink); text-decoration: none; }
      .brand:hover { text-decoration: none; }
      .brand__name { font-family: var(--mono); font-size: .95rem; font-weight: 500; }
      .brand__meta { font-family: var(--mono); font-size: .7rem; color: var(--muted); }

      .nav { display: flex; gap: 1.1rem; flex-wrap: wrap; margin-inline-start: auto; }
      .nav a { font-size: .87rem; color: var(--ink-2); }
      .nav a[aria-current='page'] { color: var(--accent); }

      .theme { font-family: var(--mono); font-size: .72rem; min-width: 5.4rem; justify-content: center; }

      .main { padding-block: 2.5rem 5rem; display: flex; flex-direction: column; gap: 2.5rem; }
      .main--wide { max-width: none; }

      .footer { border-top: 1px solid var(--rule); background: var(--surface); }
      .footer__inner {
        display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
        padding-block: 1.5rem; font-family: var(--mono); font-size: .74rem; color: var(--muted);
      }

      @media (max-width: 640px) {
        .nav { margin-inline-start: 0; order: 3; width: 100%; }
      }
    </style>
  </body>
</html>
