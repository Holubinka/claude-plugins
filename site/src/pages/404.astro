---
import Base from '../layouts/Base.astro';
import Search from '../islands/Search';
import { marketplace } from '../lib/catalog';
import { href } from '../lib/url';
import { notFound as s, chrome } from '../lib/strings';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const issueUrl = marketplace.repo ? `https://github.com/${marketplace.repo}/issues/new` : null;
---

<Base title={s.title}>
  <header class="head">
    <p class="eyebrow">{s.eyebrow}</p>
    <h1>{s.heading}</h1>
    <p class="lede">{s.lede}</p>
  </header>

  <Search client:load docsUrl={href('/data/search-docs.json')} base={base} issueUrl={issueUrl} />

  <div id="browse">
    <p><a href={href('/')}>{chrome.backToCatalogue}</a></p>
  </div>

  <script is:inline>
    // Seed the box with whatever the visitor was reaching for.
    addEventListener('DOMContentLoaded', () => {
      const guess = decodeURIComponent(location.pathname.split('/').filter(Boolean).pop() ?? '')
        .replace(/[-_]/g, ' ');
      const field = document.querySelector('input[type="search"]');
      if (field && guess && guess !== '404') {
        field.value = guess;
        field.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
  </script>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: .6rem; }
</style>
