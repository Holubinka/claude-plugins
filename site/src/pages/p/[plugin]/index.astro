---
import Base from '../../../layouts/Base.astro';
import InstallBlock from '../../../components/InstallBlock.astro';
import CapabilityPanel from '../../../components/CapabilityPanel.astro';
import HealthBadges from '../../../components/HealthBadges.astro';
import ArtifactCard from '../../../components/ArtifactCard.astro';
import { plugins, artifactsOf, health } from '../../../lib/catalog';
import { renderMarkdown } from '../../../lib/md';
import { href } from '../../../lib/url';
import { date, authorName } from '../../../lib/format';

export function getStaticPaths() {
  return plugins.map((plugin) => ({ params: { plugin: plugin.name }, props: { plugin } }));
}

const { plugin } = Astro.props;
const own = artifactsOf(plugin.name);
const readme = renderMarkdown(plugin.readme);
const author = authorName(plugin.author);
---

<Base title={plugin.name} description={plugin.description}
  record={{ name: plugin.name, kind: "plugin", desc: plugin.description }}>
  <header class="head">
    <p class="eyebrow">Plugin</p>
    <h1>{plugin.name}</h1>
    <p class="lede">{plugin.description}</p>
    <dl class="meta">
      {plugin.version && <div><dt>Version</dt><dd>{plugin.version}</dd></div>}
      {author && <div><dt>Author</dt><dd>{author}</dd></div>}
      {plugin.license && <div><dt>License</dt><dd>{plugin.license}</dd></div>}
      {plugin.category && <div><dt>Category</dt><dd>{plugin.category}</dd></div>}
      <div><dt>Always-on cost</dt><dd class="num">≈{plugin.tokens.always} tokens</dd></div>
      <div><dt>Updated</dt><dd>{date(plugin.updatedAt)}</dd></div>
    </dl>
    {plugin.keywords.length > 0 && (
      <p class="chips">{plugin.keywords.map((k) => <span class="chip chip--quiet">{k}</span>)}</p>
    )}
  </header>

  <InstallBlock plugin={plugin.name} />

  <section class="block">
    <h2>Components</h2>
    {own.length === 0 ? (
      <p class="lede">This plugin exposes no components. That is almost always a layout
        mistake — see <a href={href('/docs/plugin-structure/')}>plugin structure</a>.</p>
    ) : (
      <div class="cards">
        {own.map((artifact) => <ArtifactCard artifact={artifact} />)}
      </div>
    )}
  </section>

  <CapabilityPanel capabilities={plugin.capabilities} />

  <section class="block">
    <h2>Health</h2>
    <HealthBadges entries={health(plugin)} detailed />
  </section>

  {(plugin.dependencies.length > 0 || plugin.dependents.length > 0) && (
    <section class="block">
      <h2>Dependencies</h2>
      {plugin.dependencies.length > 0 && (
        <div class="scroll">
          <table>
            <thead><tr><th>Requires</th><th>Range</th><th>Resolves</th></tr></thead>
            <tbody>
              {plugin.dependencies.map((dep) => (
                <tr>
                  <td><a href={href(`/p/${dep.name}/`)}>{dep.name}</a></td>
                  <td>{dep.range ?? <span class="chip chip--warn">unconstrained</span>}</td>
                  <td>
                    {!dep.constrained
                      ? <span class="chip chip--warn">tracks latest</span>
                      : dep.resolvable
                        ? <span class="chip chip--ok">a tag satisfies it</span>
                        : <span class="chip chip--err">no-matching-tag</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {plugin.dependents.length > 0 && (
        <p class="chips">Required by {plugin.dependents.map((name) => (
          <a class="chip" href={href(`/p/${name}/`)}>{name}</a>
        ))}</p>
      )}
    </section>
  )}

  {plugin.releases.length > 0 && (
    <section class="block">
      <h2>Releases</h2>
      <div class="scroll">
        <table>
          <thead><tr><th>Version</th><th>Date</th><th>Changes</th></tr></thead>
          <tbody>
            {plugin.releases.map((release) => (
              <tr>
                <td class="num">{release.version}</td>
                <td>{date(release.date)}</td>
                <td>
                  <ul class="changes">{release.changes.map((line) => <li>{line}</li>)}</ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {readme && (
    <section class="block">
      <h2>README</h2>
      <div class="prose" set:html={readme} />
    </section>
  )}

  {plugin.githubUrl && (
    <p><a href={plugin.githubUrl}>Source on GitHub →</a></p>
  )}
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: .7rem; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: .8rem 1.5rem; margin: .5rem 0 0; padding-top: 1rem; border-top: 1px solid var(--rule); }
  .meta div { display: flex; flex-direction: column; gap: .1rem; }
  .meta dt { font-family: var(--mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .meta dd { margin: 0; font-family: var(--mono); font-size: .84rem; }
  .chips { display: flex; gap: .35rem; flex-wrap: wrap; align-items: center; }
  .block { display: flex; flex-direction: column; gap: .9rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: .75rem; }
  .changes { margin: 0; padding-left: 1rem; display: flex; flex-direction: column; gap: .2rem; }
</style>
