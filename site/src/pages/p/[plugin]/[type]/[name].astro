---
import Base from '../../../../layouts/Base.astro';
import InstallBlock from '../../../../components/InstallBlock.astro';
import TokenBadge from '../../../../components/TokenBadge.astro';
import TypeBadge from '../../../../components/TypeBadge.astro';
import { artifacts, plugin as findPlugin } from '../../../../lib/catalog';
import { renderMarkdown } from '../../../../lib/md';
import { href } from '../../../../lib/url';
import { date } from '../../../../lib/format';
import { artifactPage as s, chrome } from '../../../../lib/strings';

export function getStaticPaths() {
  return artifacts
    .filter((artifact) => artifact.plugin !== null)
    .map((artifact) => ({
      params: { plugin: artifact.plugin!, type: artifact.type, name: artifact.name },
      props: { artifact },
    }));
}

const { artifact } = Astro.props;
const owner = findPlugin(artifact.plugin!);
const body = renderMarkdown(artifact.body);
const frontmatter = Object.entries(artifact.frontmatter);
---

<Base title={artifact.invocation || artifact.title} description={artifact.description}
  record={{ name: artifact.invocation || artifact.title, kind: artifact.type, desc: artifact.description }}>
  <header class="head">
    <p class="crumbs">
      <a href={href('/')}>{s.crumbRoot}</a> /
      <a href={href(`/p/${artifact.plugin}/`)}>{artifact.plugin}</a> /
      <span>{artifact.type}</span>
    </p>
    <div class="title">
      <TypeBadge type={artifact.type} />
      <h1>{artifact.invocation || artifact.title}</h1>
    </div>
    <dl class="meta">
      {owner?.version && <div><dt>{s.pluginVersion}</dt><dd>{owner.version}</dd></div>}
      <div><dt>{s.updated}</dt><dd>{date(artifact.updatedAt)}</dd></div>
      <div><dt>{s.source}</dt><dd><code>{artifact.path}</code></dd></div>
    </dl>
  </header>

  <InstallBlock plugin={artifact.plugin!} />

  <section class="note">
    <p class="eyebrow" style="color: var(--accent)">{s.triggerEyebrow}</p>
    {artifact.description
      ? <p class="trigger">{artifact.description}</p>
      : <p class="trigger">{s.noDescription}</p>}
    <p class="aside">{s.triggerAside}</p>
  </section>

  {artifact.tokens && (
    <section class="panel">
      <p class="panel__label"><span>{s.contextCost}</span><span>{s.contextCostFormula}</span></p>
      <div class="panel__body">
        <TokenBadge tokens={artifact.tokens} verbose />
      </div>
    </section>
  )}

  {body && (
    <section class="block">
      <h2>{s.bodyHeading}</h2>
      <div class="prose" set:html={body} />
    </section>
  )}

  {frontmatter.length > 0 && (
    <section class="block">
      <h2>{s.frontmatter}</h2>
      <div class="scroll">
        <table>
          <tbody>
            {frontmatter.map(([key, value]) => (
              <tr>
                <th scope="row">{key}</th>
                <td><code>{Array.isArray(value) ? value.join(', ') : String(value)}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {artifact.referencedFiles.length > 0 && (
    <section class="block">
      <h2>{s.referencedFiles}</h2>
      <p class="chips">{artifact.referencedFiles.map((file) => <span class="chip chip--quiet">{file}</span>)}</p>
    </section>
  )}

  {artifact.githubUrl && <p><a href={artifact.githubUrl}>{chrome.sourceOnGitHub}</a></p>}
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: .6rem; }
  .crumbs { font-family: var(--mono); font-size: .74rem; color: var(--muted); display: flex; gap: .4rem; flex-wrap: wrap; }
  .title { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
  .title h1 { font-family: var(--mono); font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 500; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .8rem 1.5rem; margin: .4rem 0 0; padding-top: .9rem; border-top: 1px solid var(--rule); }
  .meta div { display: flex; flex-direction: column; gap: .1rem; }
  .meta dt { font-family: var(--mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .meta dd { margin: 0; font-size: .84rem; }
  .trigger { font-size: 1.02rem; }
  .aside { font-size: .84rem; color: var(--muted); }
  .block { display: flex; flex-direction: column; gap: .9rem; }
  .chips { display: flex; gap: .35rem; flex-wrap: wrap; }
  th[scope='row'] { font-family: var(--mono); font-size: .76rem; white-space: nowrap; }
</style>
