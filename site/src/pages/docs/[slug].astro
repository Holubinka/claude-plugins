---
import Base from '../../layouts/Base.astro';
import { docSlugs, docSections } from '../../lib/catalog';
import { renderMarkdown } from '../../lib/md';
import { href } from '../../lib/url';

export function getStaticPaths() {
  return docSlugs().map(({ slug, title }) => ({ params: { slug }, props: { slug, title } }));
}

const { slug, title } = Astro.props;
const sections = docSections(slug);
const contents = sections.filter((section) => section.name !== sections[0]?.name);
---

<Base title={title} description={sections[0]?.description}>
  <header class="head">
    <p class="eyebrow">Documentation</p>
    <h1>{title}</h1>
    {sections[0]?.githubUrl && <p><a href={sections[0].githubUrl}>Edit on GitHub →</a></p>}
  </header>

  <div class="doc">
    {contents.length > 0 && (
      <nav class="toc" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ol>
          {contents.map((section) => (
            <li><a href={`#${section.name}`}>{section.title}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="body">
      {sections.map((section) => (
        <section id={section.name} class="section">
          {section !== sections[0] && <h2>{section.title}</h2>}
          <div class="prose" set:html={renderMarkdown(section.body)} />
        </section>
      ))}
    </div>
  </div>

  <p class="back"><a href={href('/')}>← Back to the catalogue</a></p>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: .5rem; }
  .doc { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 3rem; align-items: start; }
  .toc { position: sticky; top: 2rem; display: flex; flex-direction: column; gap: .6rem; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .toc li { border-top: 1px solid var(--rule); }
  .toc li:last-child { border-bottom: 1px solid var(--rule); }
  .toc a { display: block; padding: .45rem 0; font-size: .84rem; color: var(--ink-2); }
  .body { display: flex; flex-direction: column; gap: 2.5rem; min-width: 0; }
  .section { scroll-margin-top: 1.5rem; display: flex; flex-direction: column; gap: .8rem; }
  .back { font-size: .85rem; }
  @media (max-width: 900px) {
    .doc { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
    .toc { position: static; }
  }
</style>
