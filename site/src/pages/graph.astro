---
import Base from '../layouts/Base.astro';
import { graph, plugins } from '../lib/catalog';
import { href } from '../lib/url';
import GraphCanvas from '../islands/GraphCanvas.tsx';
import { graph as s } from '../lib/strings';

const outgoing = new Map<string, string[]>();
for (const edge of graph.edges) {
  outgoing.set(edge.from, (outgoing.get(edge.from) ?? []).concat(edge.to));
}
const problems = graph.edges.filter((edge) => !edge.constrained || !edge.resolvable);
---

<Base title={s.title} description={s.description}>
  <header class="head">
    <p class="eyebrow">{s.eyebrow}</p>
    <h1>{s.heading}</h1>
    <p class="lede">{s.lede}</p>
  </header>

  {graph.nodes.length === 0 ? (
    <div class="note"><p>{s.empty}</p></div>
  ) : (
    <>
      <GraphCanvas client:load graph={graph} label={s.figureLabel(plugins.length)}
                   hint={s.dragHint} resetLabel={s.resetLayout} />

      <section class="block">
        <h2>{s.problems}</h2>
        {problems.length === 0 ? (
          <p class="chip chip--ok">{s.allClean}</p>
        ) : (
          <div class="scroll">
            <table>
              <thead><tr><th>{s.colFrom}</th><th>{s.colTo}</th><th>{s.colRange}</th><th>{s.colProblem}</th></tr></thead>
              <tbody>
                {problems.map((edge) => (
                  <tr>
                    <td><a href={href(`/p/${edge.from}/`)}>{edge.from}</a></td>
                    <td>{edge.external ? edge.to : <a href={href(`/p/${edge.to}/`)}>{edge.to}</a>}</td>
                    <td>{edge.range ?? '—'}</td>
                    <td>
                      {!edge.constrained
                        ? <span class="chip chip--warn">{s.tracksLatest}</span>
                        : <span class="chip chip--err">{s.noMatchingTag}</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </>
  )}
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: .6rem; }
  .block { display: flex; flex-direction: column; gap: .9rem; }
</style>
