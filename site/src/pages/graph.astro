---
import Base from '../layouts/Base.astro';
import { graph, plugins } from '../lib/catalog';
import { href } from '../lib/url';
import { graph as s } from '../lib/strings';

const byId = new Map(graph.nodes.map((node) => [node.id, node]));
const outgoing = new Map<string, string[]>();
for (const edge of graph.edges) {
  outgoing.set(edge.from, (outgoing.get(edge.from) ?? []).concat(edge.to));
}
const problems = graph.edges.filter((edge) => !edge.constrained || !edge.resolvable);
---

<Base title={s.title} description={s.description}>
  <header class="head">
    <p class="eyebrow">{s.eyebrow}</p>
    <h1>{s.heading}</h1>
    <p class="lede">{s.lede}</p>
  </header>

  {graph.nodes.length === 0 ? (
    <div class="note"><p>{s.empty}</p></div>
  ) : (
    <>
      <div class="scroll figure">
        <svg viewBox={`0 0 ${graph.width} ${graph.height}`} role="img"
             aria-label={s.figureLabel(plugins.length)}>
          <defs>
            <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M0 0 L8 4 L0 8 z" fill="currentColor" />
            </marker>
          </defs>
          <g class="edges">
            {graph.edges.map((edge) => {
              const from = byId.get(edge.from);
              const to = byId.get(edge.to);
              if (!from || !to) return null;
              // Outgoing edges leave their source spread down its left side, so several
              // dependencies never share a start point or a label position.
              const siblings = outgoing.get(edge.from) ?? [];
              const slot = siblings.indexOf(edge.to);
              const spread = (slot + 1) / (siblings.length + 1);
              const y1 = from.y + from.height * spread;
              const x1 = from.x;
              const x2 = to.x + to.width;
              const y2 = to.y + to.height / 2;
              const state = !edge.constrained ? 'loose' : edge.resolvable ? 'ok' : 'broken';

              // An edge between adjacent columns crosses a gutter and nothing else, so it
              // is drawn straight. One that skips a column would sweep through whatever
              // boxes stand in between — those are routed down into a lane of their own
              // below the diagram, along it, and back up into the target.
              if (edge.lane === null || edge.lane === undefined) {
                const bend = Math.max(48, (x1 - x2) / 2);
                return (
                  <g class={`edge edge--${state}`}>
                    <path d={`M${x1} ${y1} C${x1 - bend} ${y1}, ${x2 + bend} ${y2}, ${x2 + 9} ${y2}`}
                          marker-end="url(#arrow)" />
                    <text x={x1 - 10} y={y1 - 5} text-anchor="end">{edge.range ?? 'latest'}</text>
                  </g>
                );
              }

              const r = 7;
              const laneY = graph.laneTop + edge.lane * graph.laneGap;
              const xa = x1 - 16;          // turn down, just left of the source
              const xb = x2 + 22;          // turn up, just right of the target
              const d = [
                `M${x1} ${y1}`,
                `L${xa + r} ${y1}`, `Q${xa} ${y1} ${xa} ${y1 + r}`,
                `L${xa} ${laneY - r}`, `Q${xa} ${laneY} ${xa - r} ${laneY}`,
                `L${xb + r} ${laneY}`, `Q${xb} ${laneY} ${xb} ${laneY - r}`,
                `L${xb} ${y2 + r}`, `Q${xb} ${y2} ${xb - r} ${y2}`,
                `L${x2 + 9} ${y2}`,
              ].join(' ');
              return (
                <g class={`edge edge--${state} edge--routed`}>
                  <path d={d} marker-end="url(#arrow)" />
                  <text x={(xa + xb) / 2} y={laneY - 4} text-anchor="middle">
                    {edge.from} → {edge.to} {edge.range ?? 'latest'}
                  </text>
                </g>
              );
            })}
          </g>
          <g class="nodes">
            {graph.nodes.map((node) => (
              <g class="node">
                <rect x={node.x} y={node.y} width={node.width} height={node.height} rx="4" />
                <text x={node.x + 14} y={node.y + 25} class="title">{node.label}</text>
                <text x={node.x + 14} y={node.y + 40} class="sub">
                  {node.version ? `v${node.version}` : 'unversioned'}
                </text>
                <line x1={node.x} y1={node.y + 50} x2={node.x + node.width} y2={node.y + 50} />
                {node.rows.map((row, index) => (
                  <>
                    <text x={node.x + 14} y={node.y + 68 + index * 17} class="kind">{row.type}</text>
                    <text x={node.x + 14 + node.typeColumn} y={node.y + 68 + index * 17} class="part">{row.name}</text>
                  </>
                ))}
                {node.more > 0 && (
                  <text x={node.x + 14} y={node.y + 68 + node.rows.length * 17} class="sub">
                    +{node.more} more
                  </text>
                )}
              </g>
            ))}
          </g>
        </svg>
      </div>

      <section class="block">
        <h2>{s.problems}</h2>
        {problems.length === 0 ? (
          <p class="chip chip--ok">{s.allClean}</p>
        ) : (
          <div class="scroll">
            <table>
              <thead><tr><th>{s.colFrom}</th><th>{s.colTo}</th><th>{s.colRange}</th><th>{s.colProblem}</th></tr></thead>
              <tbody>
                {problems.map((edge) => (
                  <tr>
                    <td><a href={href(`/p/${edge.from}/`)}>{edge.from}</a></td>
                    <td>{edge.external ? edge.to : <a href={href(`/p/${edge.to}/`)}>{edge.to}</a>}</td>
                    <td>{edge.range ?? '—'}</td>
                    <td>
                      {!edge.constrained
                        ? <span class="chip chip--warn">{s.tracksLatest}</span>
                        : <span class="chip chip--err">{s.noMatchingTag}</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </>
  )}
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: .6rem; }
  .block { display: flex; flex-direction: column; gap: .9rem; }
  .figure { padding: 1.25rem 1rem; }
  svg { display: block; width: 100%; min-width: 34rem; height: auto; }
  .node rect { fill: var(--surface); stroke: var(--rule-2); stroke-width: 1; }
  .node line { stroke: var(--rule); stroke-width: 1; }
  .node text.title { fill: var(--ink); font-family: var(--mono); font-size: 13px; font-weight: 500; }
  .node text.sub { fill: var(--muted); font-family: var(--mono); font-size: 9.5px; }
  .node text.kind { fill: var(--accent); font-family: var(--mono); font-size: 11px; }
  .node text.part { fill: var(--ink-2); font-family: var(--mono); font-size: 11px; }
  .edge path { fill: none; stroke-width: 1.25; }
  .edge--routed path { stroke-dasharray: none; opacity: 0.85; }
  .edge text { font-family: var(--mono); font-size: 9px; }
  .edge--ok     { color: var(--rule-2); }
  .edge--ok path     { stroke: var(--rule-2); }
  .edge--ok text     { fill: var(--muted); }
  .edge--loose  { color: var(--warn); }
  .edge--loose path  { stroke: var(--warn); stroke-dasharray: 4 3; }
  .edge--loose text  { fill: var(--warn); }
  .edge--broken { color: var(--danger); }
  .edge--broken path { stroke: var(--danger); }
  .edge--broken text { fill: var(--danger); }
</style>
