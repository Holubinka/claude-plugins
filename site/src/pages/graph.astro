---
import Base from '../layouts/Base.astro';
import { graph, plugins } from '../lib/catalog';
import { href } from '../lib/url';
import GraphCanvas from '../islands/GraphCanvas.tsx';
import { graph as s } from '../lib/strings';

const byId = new Map(graph.nodes.map((node) => [node.id, node]));
const outgoing = new Map<string, string[]>();
for (const edge of graph.edges) {
  outgoing.set(edge.from, (outgoing.get(edge.from) ?? []).concat(edge.to));
}
const problems = graph.edges.filter((edge) => !edge.constrained || !edge.resolvable);
---

<Base title={s.title} description={s.description}>
  <header class="head">
    <p class="eyebrow">{s.eyebrow}</p>
    <h1>{s.heading}</h1>
    <p class="lede">{s.lede}</p>
  </header>

  {graph.nodes.length === 0 ? (
    <div class="note"><p>{s.empty}</p></div>
  ) : (
    <>
      <GraphCanvas client:load graph={graph} label={s.figureLabel(plugins.length)}
                   hint={s.dragHint} resetLabel={s.resetLayout} />

      <section class="block">
        <h2>{s.problems}</h2>
        {problems.length === 0 ? (
          <p class="chip chip--ok">{s.allClean}</p>
        ) : (
          <div class="scroll">
            <table>
              <thead><tr><th>{s.colFrom}</th><th>{s.colTo}</th><th>{s.colRange}</th><th>{s.colProblem}</th></tr></thead>
              <tbody>
                {problems.map((edge) => (
                  <tr>
                    <td><a href={href(`/p/${edge.from}/`)}>{edge.from}</a></td>
                    <td>{edge.external ? edge.to : <a href={href(`/p/${edge.to}/`)}>{edge.to}</a>}</td>
                    <td>{edge.range ?? '—'}</td>
                    <td>
                      {!edge.constrained
                        ? <span class="chip chip--warn">{s.tracksLatest}</span>
                        : <span class="chip chip--err">{s.noMatchingTag}</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </>
  )}
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: .6rem; }
  .block { display: flex; flex-direction: column; gap: .9rem; }
  .figure { padding: 1.25rem 1rem; }
  svg { display: block; width: 100%; min-width: 34rem; height: auto; }
  .node rect { fill: var(--surface); stroke: var(--rule-2); stroke-width: 1; }
  .node line { stroke: var(--rule); stroke-width: 1; }
  .node text.title { fill: var(--ink); font-family: var(--mono); font-size: 13px; font-weight: 500; }
  .node text.sub { fill: var(--muted); font-family: var(--mono); font-size: 9.5px; }
  .node text.kind { fill: var(--accent); font-family: var(--mono); font-size: 11px; }
  .node text.part { fill: var(--ink-2); font-family: var(--mono); font-size: 11px; }
  .graph-tools { display: flex; align-items: center; gap: 1rem; margin-bottom: .5rem; flex-wrap: wrap; }
  .graph-tools .hint { font-size: .82rem; color: var(--muted); }
  .graph-tools button { font: inherit; font-size: .82rem; padding: .2rem .6rem; cursor: pointer;
    background: none; border: 1px solid var(--rule); border-radius: 4px; color: var(--ink); }
  .node { cursor: grab; }
  .node:active { cursor: grabbing; }
  .node a { cursor: pointer; }
  .node a text { text-decoration: none; }
  .node a:hover text, .node a:focus text { text-decoration: underline; }
  .edge path { fill: none; stroke-width: 1.25; }
  .edge--routed path { stroke-dasharray: none; opacity: 0.85; }
  .edge text { font-family: var(--mono); font-size: 9px; }
  .edge--ok     { color: var(--rule-2); }
  .edge--ok path     { stroke: var(--rule-2); }
  .edge--ok text     { fill: var(--muted); }
  .edge--loose  { color: var(--warn); }
  .edge--loose path  { stroke: var(--warn); stroke-dasharray: 4 3; }
  .edge--loose text  { fill: var(--warn); }
  .edge--broken { color: var(--danger); }
  .edge--broken path { stroke: var(--danger); }
  .edge--broken text { fill: var(--danger); }
</style>
