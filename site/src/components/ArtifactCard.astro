---
import type { Artifact } from '../lib/catalog';
import { href } from '../lib/url';
import TypeBadge from './TypeBadge.astro';
import TokenBadge from './TokenBadge.astro';

interface Props { artifact: Artifact }
const { artifact } = Astro.props;
---

<article class="card">
  <div class="card__head">
    <TypeBadge type={artifact.type} />
    {artifact.plugin && <a class="card__plugin" href={href(`/p/${artifact.plugin}/`)}>{artifact.plugin}</a>}
    <TokenBadge tokens={artifact.tokens} />
  </div>
  <h3><a href={href(artifact.url)}>{artifact.invocation || artifact.title}</a></h3>
  <p class="card__trigger">{artifact.description}</p>
  {artifact.keywords.length > 0 && (
    <p class="card__keywords">{artifact.keywords.map((k) => <span class="chip chip--quiet">{k}</span>)}</p>
  )}
</article>

<style>
  .card {
    display: flex; flex-direction: column; gap: .5rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--block-line); border-radius: var(--radius);
    background: var(--surface);
  }
  .card:hover { border-color: var(--rule-2); }
  .card__head { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .card__plugin { font-family: var(--mono); font-size: .74rem; color: var(--muted); }
  .card h3 { font-family: var(--mono); font-size: .95rem; font-weight: 500; }
  .card__trigger { font-size: .9rem; color: var(--ink-2); }
  .card__keywords { display: flex; gap: .3rem; flex-wrap: wrap; }
</style>
