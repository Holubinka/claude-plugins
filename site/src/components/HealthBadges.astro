---
import type { HealthEntry } from '../lib/catalog';
import { health as s } from '../lib/strings';

interface Props { entries: HealthEntry[]; detailed?: boolean }
const { entries, detailed = false } = Astro.props;
const errors = entries.filter((e) => e.level === 'error');
const warnings = entries.filter((e) => e.level === 'warn');
---

{entries.length === 0 ? (
  <p class="chip chip--ok">{s.none}</p>
) : detailed ? (
  <div class="scroll">
    <table>
      <thead><tr><th>{s.colCode}</th><th>{s.colFinding}</th></tr></thead>
      <tbody>
        {[...errors, ...warnings].map((entry) => (
          <tr>
            <td><span class={`chip ${entry.level === 'error' ? 'chip--err' : 'chip--warn'}`}>{entry.code}</span></td>
            <td>{entry.message}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
) : (
  <p class="badges">
    {errors.length > 0 && <span class="chip chip--err">{s.errors(errors.length)}</span>}
    {warnings.length > 0 && <span class="chip chip--warn">{s.warnings(warnings.length)}</span>}
  </p>
)}

<style>
  .badges { display: flex; gap: .4rem; flex-wrap: wrap; }
</style>
