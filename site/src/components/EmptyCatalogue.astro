---
import { marketplace } from '../lib/catalog';
import { emptyCatalogue as s } from '../lib/strings';
const repo = marketplace.repo;
---

<div class="note">
  <p class="eyebrow" style="color: var(--accent)">{s.eyebrow}</p>
  <p>{s.body}</p>
  <p>{s.docsNote}</p>
  {repo && (
    <p>
      <a class="button" href={`https://github.com/${repo}/blob/main/CONTRIBUTING.md`}>{s.howTo}</a>
    </p>
  )}
</div>
