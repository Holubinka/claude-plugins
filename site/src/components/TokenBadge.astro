---
import type { TokenCost } from '../lib/catalog';
import { tokens as s } from '../lib/strings';

interface Props { tokens: TokenCost | null; verbose?: boolean }
const { tokens, verbose = false } = Astro.props;
---
{tokens && (
  verbose ? (
    <dl class="cost">
      <div>
        <dt>{s.always}</dt>
        <dd class="num">≈{tokens.always}</dd>
        <p>{s.alwaysNote}</p>
      </div>
      <div>
        <dt>{s.onLoad}</dt>
        <dd class="num">≈{tokens.onLoad}</dd>
        <p>{s.onLoadNote}</p>
      </div>
    </dl>
  ) : (
    <span class="tokens" title={s.inlineTitle}>
      <span>{s.inlineAlways} <b>≈{tokens.always}</b></span>
      <span>{s.inlineOnLoad} <b>≈{tokens.onLoad}</b></span>
    </span>
  )
)}

<style>
  .cost { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem 2rem; margin: 0; }
  .cost > div { display: flex; flex-direction: column; gap: .15rem; }
  .cost dt { font-family: var(--mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .cost dd { margin: 0; font-family: var(--mono); font-size: 1.35rem; color: var(--ink); }
  .cost p { font-size: .82rem; color: var(--muted); }
</style>
