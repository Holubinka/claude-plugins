---
import type { Capabilities } from '../lib/catalog';
import { capabilities as s } from '../lib/strings';

interface Props { capabilities: Capabilities }
const { capabilities: c } = Astro.props;

const declared =
  c.interceptsEvents.length + c.mcpServers.length + c.lspServers.length +
  c.bundledScripts.length + c.allowedTools.length;
---

<section class="panel" aria-labelledby="caps">
  <p class="panel__label" id="caps">
    <span>{s.heading}</span>
    <span>{declared === 0 ? s.nothingDeclared : s.factsNotScore}</span>
  </p>
  <div class="panel__body caps">
    {declared === 0 ? (
      <p class="empty">{s.empty}</p>
    ) : (
      <>
        {c.interceptsEvents.length > 0 && (
          <div class="row">
            <h3>{s.intercepts}</h3>
            <p class="chips">{c.interceptsEvents.map((e) => <span class="chip">{e}</span>)}</p>
          </div>
        )}
        {c.hookCommands.length > 0 && (
          <div class="row">
            <h3>{s.runs}</h3>
            <ul>{c.hookCommands.map((cmd) => <li><code>{cmd}</code></li>)}</ul>
          </div>
        )}
        {c.mcpServers.length > 0 && (
          <div class="row">
            <h3>{s.mcpServers}</h3>
            <ul>
              {c.mcpServers.map((server) => (
                <li>
                  <code>{server.name}</code> {s.over} {server.transport}
                  {server.command && <> {s.as} <code>{[server.command, ...server.args].join(' ')}</code></>}
                  {server.host && <> {s.to} <code>{server.host}</code></>}
                  {server.envKeys.length > 0 && (
                    <> · {s.reads} {server.envKeys.map((k) => <code>{k}</code>)}</>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
        {c.lspServers.length > 0 && (
          <div class="row">
            <h3>{s.lspServers}</h3>
            <ul>{c.lspServers.map((server) => <li><code>{server.name}</code>{server.command && <> {s.as} <code>{server.command}</code></>}</li>)}</ul>
          </div>
        )}
        {c.networkHosts.length > 0 && (
          <div class="row">
            <h3>{s.network}</h3>
            <p class="chips">{c.networkHosts.map((h) => <span class="chip">{h}</span>)}</p>
          </div>
        )}
        {c.bundledScripts.length > 0 && (
          <div class="row">
            <h3>{s.bundledScripts}</h3>
            <p class="chips">{c.bundledScripts.map((script) => <span class="chip">{script}</span>)}</p>
          </div>
        )}
        {c.allowedTools.length > 0 && (
          <div class="row">
            <h3>{s.declaredTools}</h3>
            <p class="chips">{c.allowedTools.map((t) => <span class="chip">{t}</span>)}</p>
          </div>
        )}
        <p class="footnote">{s.footnote}</p>
      </>
    )}
  </div>
</section>

<style>
  .caps { display: flex; flex-direction: column; gap: 1rem; }
  .row { display: flex; flex-direction: column; gap: .4rem; }
  .row h3 { font-family: var(--mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .chips { display: flex; gap: .35rem; flex-wrap: wrap; }
  ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .3rem; font-size: .87rem; }
  .empty { color: var(--muted); font-size: .9rem; max-width: 60ch; }
  .footnote { font-size: .78rem; color: var(--muted); border-top: 1px solid var(--rule); padding-top: .7rem; }
</style>
